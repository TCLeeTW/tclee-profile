---
import Base from '../layouts/Base.astro';
import type { CollectionEntry } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale; article: CollectionEntry<'articles'> }
const { locale, article } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const { title, description, date, category } = article.data;
const { Content } = await article.render();
---

<Base title={title} description={description} activeNav="thoughts" locale={locale}>
<div class="detail">
  <a class="back" href={withLocale('/thoughts')}>{t.thoughtsPage.backAllThoughts}</a>

  <div class="dhead">
    <div class="dmeta"><span>{article.data.lang === 'zh' ? '中文' : 'EN'}</span><span>·</span><span>{date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></div>
    <h1>{title}</h1>
    <p class="sum">{description}</p>
  </div>

  <div class="qblock">
    <Content />
  </div>

  <div class="dtags"><span class="chip">{category}</span></div>

  <a class="back" href={withLocale('/thoughts')}>{t.thoughtsPage.backAllThoughts}</a>
</div>
</Base>
