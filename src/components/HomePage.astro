---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const [latestProject] = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base locale={locale}>
<div class="wrap">

  <div class="hero">
    <div>
      <div class="eyebrow">{t.home.eyebrow}</div>
      <h1>TC Lee<em>李澤中</em></h1>
      <p class="lede">{t.home.lede}</p>
      <p class="sub">{t.home.sub}</p>
      <div class="actions">
        <a class="btn" href={withLocale('/projects')}>{t.home.seeWork}</a>
        <a class="btn ghost" href="#contact">{t.home.getInTouch}</a>
      </div>
    </div>
    <div class="portrait"><img src="/portrait.webp" alt="TC Lee" width="480" height="600" /></div>
  </div>

  <section id="pillars">
    <div class="shead"><div><div class="kicker">{t.home.pillarsKicker}</div><h2>{t.home.pillarsHeading}</h2></div></div>
    <div class="pillars">
      <div class="pillar">
        <div class="pnum">01</div>
        <h3>{t.home.pillar01Title}</h3>
        <p>{t.home.pillar01Body}</p>
        <div class="chips"><span class="chip">IPC</span><span class="chip">Edge AI</span><span class="chip">EN 50155</span><span class="chip">Europe</span></div>
      </div>
      <div class="pillar">
        <div class="pnum">02</div>
        <h3>{t.home.pillar02Title}</h3>
        <p>{t.home.pillar02Body}</p>
        <div class="chips"><span class="chip">Training</span><span class="chip">Exercises</span><span class="chip">TAK</span><span class="chip">Drones</span></div>
      </div>
      <div class="pillar">
        <div class="pnum">03</div>
        <h3>{t.home.pillar03Title}</h3>
        <p>{t.home.pillar03Body}</p>
        <div class="chips"><span class="chip">Agents</span><span class="chip">Automation</span><span class="chip">GIS</span></div>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="shead">
      <div><div class="kicker">{t.home.projectsKicker}</div><h2>{t.home.projectsHeading}</h2></div>
      <a href={withLocale('/projects')}>{t.home.allProjects}</a>
    </div>
    {latestProject && (() => {
      const p = latestProject;
      const title = locale === 'zh' ? (p.data.zh?.title ?? p.data.title) : p.data.title;
      const summary = locale === 'zh' ? (p.data.zh?.summary ?? p.data.summary) : p.data.summary;
      const catLabel = t.categories[p.data.category];
      return p.data.ready ? (
        <a class="proj" style="max-width:460px" href={withLocale(`/projects/${p.slug}`)}>
          <div class="ptop"><span class="ptag">{catLabel}</span><span class="pyear">{p.data.year}</span></div>
          <h3>{title}</h3>
          <p>{summary}</p>
          <span class="more">{t.projectsPage.readCase}</span>
        </a>
      ) : (
        <div class="proj disabled" style="max-width:460px">
          <div class="ptop"><span class="ptag">{catLabel}</span><span class="pyear">{p.data.year}</span></div>
          <h3>{title}</h3>
          <p>{summary}</p>
          <span class="more soon">{t.projectsPage.writeUpComing}</span>
        </div>
      );
    })()}
  </section>

  {articles.length > 0 && (
    <section id="thoughts">
      <div class="shead">
        <div><div class="kicker">{t.home.thoughtsKicker}</div><h2>{t.home.thoughtsHeading}</h2></div>
        <a href={withLocale('/thoughts')}>{t.home.allThoughts}</a>
      </div>
      {articles.map(a => (
        <a class="thought" href={withLocale(`/thoughts/${a.slug}`)}>
          <div class="trow"><h3>{a.data.title}</h3><span class="tmeta">{a.data.category} · {a.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></div>
          <p>{a.data.description}</p>
        </a>
      ))}
    </section>
  )}

  <section id="contact">
    <div class="contact">
      <div>
        <div class="kicker">{t.home.contactKicker}</div>
        <h2>{t.home.contactHeading}</h2>
        <p>{t.home.contactBody}</p>
      </div>
      <div class="actions">
        <a class="btn" href="mailto:t.c.lee.taiwan@gmail.com">{t.home.emailMe}</a>
        <a class="btn ghost" href="https://linkedin.com/in/t-c-lee" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

</div>
</Base>
