---
import Base from '../layouts/Base.astro';
import type { CollectionEntry } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale; project: CollectionEntry<'projects'> }
const { locale, project } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const d = project.data;
const zh = d.zh;
const title = locale === 'zh' ? (zh?.title ?? d.title) : d.title;
const summary = locale === 'zh' ? (zh?.summary ?? d.summary) : d.summary;
const why = locale === 'zh' ? (zh?.why ?? d.why) : d.why;
const how = locale === 'zh' ? (zh?.how ?? d.how) : d.how;
const what = locale === 'zh' ? (zh?.what ?? d.what) : d.what;
const additional = locale === 'zh' ? (zh?.additional ?? d.additional) : d.additional;

const youtubeMatch = d.video?.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=|youtube\.com\/embed\/)([\w-]+)/);
const youtubeEmbed = youtubeMatch ? `https://www.youtube.com/embed/${youtubeMatch[1]}` : null;
---

<Base title={title} description={summary} activeNav="projects" locale={locale}>
<div class="detail">

  <a class="back" href={withLocale('/projects')}>{t.projectsPage.backAllProjects}</a>

  <div class="dhead">
    <div class="dmeta">
      <span>{t.categories[d.category]}</span><span>·</span><span>{d.year}</span><span>·</span><span>{d.status}</span>
      {d.date && (<><span>·</span><span>{d.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></>)}
    </div>
    <h1>{title}</h1>
    <p class="sum">{summary}</p>
    {d.tags.length > 0 && (
      <div class="dtags">{d.tags.map(tag => <span class="chip">{tag}</span>)}</div>
    )}
  </div>

  {d.image && (
    <div class="dimage"><img src={d.image} alt={title} /></div>
  )}

  {d.video && (
    <div class="dvideo">
      {youtubeEmbed ? (
        <iframe src={youtubeEmbed} title={title} frameborder="0" allowfullscreen></iframe>
      ) : (
        <a href={d.video} target="_blank" rel="noopener">{d.video}</a>
      )}
    </div>
  )}

  {why && (
    <div class="qblock">
      <div class="qlabel">Why</div>
      <h2>{why.heading}</h2>
      {why.paragraphs.map(p => <p>{p}</p>)}
    </div>
  )}

  {how && (
    <div class="qblock">
      <div class="qlabel">How</div>
      <h2>{how.heading}</h2>
      <ul>{how.items.map(i => <li>{i}</li>)}</ul>
    </div>
  )}

  {d.screenshots.length > 0 && (
    <div class="qblock shots">
      {d.screenshots.map(s => (
        <figure class="shot">
          <img src={s.src} alt={locale === 'zh' ? (s.captionZh ?? s.caption) : s.caption} loading="lazy" />
          <figcaption>{locale === 'zh' ? (s.captionZh ?? s.caption) : s.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {what && (
    <div class="qblock">
      <div class="qlabel">What</div>
      <h2>{what.heading}</h2>
      <ul>{what.items.map(i => <li>{i}</li>)}</ul>
      {what.note && <p>{what.note}</p>}
    </div>
  )}

  {additional && (
    <div class="qblock">
      <div class="qlabel">Additional Info</div>
      <ul>{additional.items.map(i => <li>{i}</li>)}</ul>
    </div>
  )}

  {d.links.length > 0 && (
    <div class="coverage">
      <h3>Links &amp; references</h3>
      {d.links.map(l => <a href={l.url} target="_blank" rel="noopener"><span>{l.label}</span><span class="src">{l.source}</span></a>)}
    </div>
  )}

  <a class="back" href={withLocale('/projects')}>{t.projectsPage.backAllProjects}</a>
</div>
</Base>
