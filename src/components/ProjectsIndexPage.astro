---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';
import { PROJECT_CATEGORIES, catKey } from '../content/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = PROJECT_CATEGORIES.filter((c) => projects.some((p) => p.data.category === c));
---

<Base title={t.projectsPage.title} description={t.projectsPage.body} activeNav="projects" locale={locale}>
<div class="wrap">
  <div class="pagehead">
    <h1>{t.projectsPage.title}</h1>
    <p>{t.projectsPage.body}</p>
  </div>

  <section style="border-top:none;padding-top:34px">
    <div class="filters">
      <button class="on" data-f="all">{t.projectsPage.filterAll}</button>
      {categories.map(cat => <button data-f={catKey(cat)}>{t.categories[cat]}</button>)}
    </div>

    <div class="timeline" id="grid">
      {projects.map(p => {
        const title = locale === 'zh' ? (p.data.zh?.title ?? p.data.title) : p.data.title;
        const summary = locale === 'zh' ? (p.data.zh?.summary ?? p.data.summary) : p.data.summary;
        const catLabel = t.categories[p.data.category];
        return (
          <div class="tl-item" data-c={catKey(p.data.category)}>
            <span class="tl-dot"></span>
            {p.data.is_published ? (
              <a class="proj" href={withLocale(`/projects/${p.slug}`)}>
                <div class="ptop"><span class="ptag">{catLabel}</span><span class="pyear">{p.data.year}</span></div>
                <h3>{title}</h3>
                <p>{summary}</p>
                <span class="more">{t.projectsPage.readCase}</span>
              </a>
            ) : (
              <div class="proj disabled">
                <div class="ptop"><span class="ptag">{catLabel}</span><span class="pyear">{p.data.year}</span></div>
                <h3>{title}</h3>
                <p>{summary}</p>
                <span class="more soon">{t.projectsPage.writeUpComing}</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>
</div>
</Base>

<script>
function applyFilter(f: string) {
  const match = document.querySelector<HTMLButtonElement>(`.filters button[data-f="${f}"]`);
  const target = match ? f : 'all';
  document.querySelectorAll('.filters button').forEach((x) => x.classList.remove('on'));
  (match ?? document.querySelector<HTMLButtonElement>('.filters button[data-f="all"]'))?.classList.add('on');
  document.querySelectorAll<HTMLElement>('#grid .tl-item').forEach((item) => {
    item.style.display = (target === 'all' || item.dataset.c === target) ? '' : 'none';
  });
}

document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) => {
  b.onclick = () => {
    applyFilter(b.dataset.f ?? 'all');
    const url = new URL(location.href);
    if (b.dataset.f === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', b.dataset.f ?? '');
    history.replaceState(null, '', url);
  };
});

const initialCat = new URLSearchParams(location.search).get('cat');
if (initialCat) applyFilter(initialCat);
</script>
