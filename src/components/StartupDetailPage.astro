---
import Base from '../layouts/Base.astro';
import type { CollectionEntry } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';

interface Props { locale: Locale; startup: CollectionEntry<'startups'> }
const { locale, startup } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const d = startup.data;
const title = locale === 'zh' ? (d.zh?.title ?? d.title) : d.title;
const summary = locale === 'zh' ? (d.zh?.summary ?? d.summary) : d.summary;
const statusLabel = d.status === 'active' ? t.projectsPage.active : t.projectsPage.closed;
const { Content } = await startup.render();
---

<Base title={title} description={summary} activeNav="projects" locale={locale}>
<div class="detail">
  <a class="back" href={withLocale('/projects')}>{t.projectsPage.backAllProjects}</a>

  <div class="dhead">
    <div class="dmeta"><span>{t.projectsPage.startupsKicker}</span><span>·</span><span>{d.period}</span><span>·</span><span>{statusLabel}</span></div>
    <h1>{title}</h1>
    <p class="sum">{summary}</p>
    {d.url && (
      <div class="dlinks">
        <a href={d.url} target="_blank" rel="noopener">Website</a>
      </div>
    )}
  </div>

  <div class="qblock">
    <Content />
  </div>

  <a class="back" href={withLocale('/projects')}>{t.projectsPage.backAllProjects}</a>
</div>
</Base>
