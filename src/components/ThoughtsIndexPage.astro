---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { strings, type Locale } from '../i18n/strings';
import { ARTICLE_CATEGORIES, catKey } from '../content/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale];
const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);

const articles = (await getCollection('articles', ({ data }) => data.is_published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = ARTICLE_CATEGORIES.filter((c) => articles.some((a) => a.data.category === c));
---

<Base title={t.thoughtsPage.title} description={t.thoughtsPage.body} activeNav="thoughts" locale={locale}>
<div class="wrap">
  <div class="pagehead">
    <h1>{t.thoughtsPage.title}</h1>
    <p>{t.thoughtsPage.body}</p>
  </div>

  <section style="border-top:none;padding-top:34px">
    {articles.length > 0 && (
      <div class="filters">
        <button class="on" data-f="all">{t.projectsPage.filterAll}</button>
        {categories.map(c => <button data-f={catKey(c)}>{c}</button>)}
      </div>
    )}

    <div id="list">
      {articles.length === 0 ? (
        <p class="empty">{t.thoughtsPage.empty}</p>
      ) : articles.map(a => (
        <a class="thought" data-c={catKey(a.data.category)} href={withLocale(`/thoughts/${a.slug}`)}>
          <div class="trow"><h3>{a.data.title}</h3><span class="tmeta">{a.data.lang === 'zh' ? '中文' : 'EN'} · {a.data.category} · {a.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span></div>
          <p>{a.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</div>
</Base>

<script>
function applyFilter(f: string) {
  const match = document.querySelector<HTMLButtonElement>(`.filters button[data-f="${f}"]`);
  const target = match ? f : 'all';
  document.querySelectorAll('.filters button').forEach((x) => x.classList.remove('on'));
  (match ?? document.querySelector<HTMLButtonElement>('.filters button[data-f="all"]'))?.classList.add('on');
  document.querySelectorAll<HTMLElement>('#list .thought').forEach((p) => {
    p.style.display = (target === 'all' || p.dataset.c === target) ? '' : 'none';
  });
}

document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((b) => {
  b.onclick = () => {
    applyFilter(b.dataset.f ?? 'all');
    const url = new URL(location.href);
    if (b.dataset.f === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', b.dataset.f ?? '');
    history.replaceState(null, '', url);
  };
});

const initialCat = new URLSearchParams(location.search).get('cat');
if (initialCat) applyFilter(initialCat);
</script>
