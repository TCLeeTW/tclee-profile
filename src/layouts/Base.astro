---
import '../styles/global.css';
import { strings, type Locale } from '../i18n/strings';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: 'projects' | 'thoughts';
  locale?: Locale;
}

const {
  title,
  description,
  ogImage = '/portrait.webp',
  activeNav,
  locale = 'en',
} = Astro.props;

const t = strings[locale];
const finalDescription = description ?? t.home.sub;
const siteTitle = title ? `${title} — TC Lee` : 'TC Lee';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const path = Astro.url.pathname;
const otherLocalePath =
  locale === 'en'
    ? `/zh${path === '/' ? '' : path}`
    : path.replace(/^\/zh(\/|$)/, '/') || '/';

const withLocale = (p: string) => (locale === 'zh' ? `/zh${p}` : p);
---

<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonicalURL} />
<title>{siteTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="alternate" hreflang="en" href={new URL(locale === 'en' ? path : otherLocalePath, Astro.site)} />
<link rel="alternate" hreflang="zh" href={new URL(locale === 'zh' ? path : otherLocalePath, Astro.site)} />

<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={new URL(ogImage, Astro.site)} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={finalDescription} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Spectral:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<header>
  <nav>
    <a class="brand" href={withLocale('/')}>TC Lee<span>李澤中</span></a>
    <div class="navlinks">
      <a class="nm" href={withLocale('/#pillars')}>{t.nav.whatIdo}</a>
      <a class={activeNav === 'projects' ? 'active' : ''} href={withLocale('/projects')}>{t.nav.projects}</a>
      <a class={activeNav === 'thoughts' ? 'active' : ''} href={withLocale('/thoughts')}>{t.nav.thoughts}</a>
      <a class="nm" href={withLocale('/about')}>{t.nav.about}</a>
      <a class="lang" href={otherLocalePath}>{t.langSwitch.label}</a>
      <a class="cta" href={withLocale('/#contact')}>{t.nav.contact}</a>
    </div>
  </nav>
</header>

<main>
  <slot />
</main>

<footer><div class="wrap foot">
  <span>© {new Date().getFullYear()} TC Lee · 李澤中</span>
  <span>
    <a href="https://linkedin.com/in/t-c-lee" target="_blank" rel="noopener">LinkedIn</a>
    <a href="https://github.com/TCLeeTW" target="_blank" rel="noopener">GitHub</a>
    <a href="mailto:t.c.lee.taiwan@gmail.com">Email</a>
  </span>
</div></footer>

</body>
</html>
