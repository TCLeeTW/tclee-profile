---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagParam = Astro.url.searchParams.get('tag');
const articles = tagParam
  ? allArticles.filter(a => a.data.tags.includes(tagParam))
  : allArticles;

const allTags = [...new Set(allArticles.flatMap(a => a.data.tags))].sort();
---

<Base title="Writing" description="Articles on industrial tech, civil defense, AI, and software.">
  <div class="mb-10">
    <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-3">Writing</h1>
    <p class="text-zinc-600 dark:text-zinc-400">
      Articles on IPC hardware, civil defense, AI implementation, and software.
      In English and Chinese.
    </p>
  </div>

  {allTags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-10">
      <a href="/writing" class={`tag ${!tagParam ? 'tag-active' : ''}`}>All</a>
      {allTags.map(tag => (
        <a href={`/writing?tag=${tag}`} class={`tag ${tagParam === tag ? 'tag-active' : ''}`}>
          {tag}
        </a>
      ))}
    </div>
  )}

  <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
    {articles.length === 0 && (
      <p class="py-8 text-zinc-500">No posts yet in this category.</p>
    )}
    {articles.map(article => (
      <article class="py-6 group">
        <a href={`/writing/${article.slug}`} class="block">
          <div class="flex items-start justify-between gap-6 mb-2">
            <h2 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {article.data.title}
              {article.data.lang === 'zh' && <span class="ml-1.5 text-xs text-zinc-400">中文</span>}
            </h2>
            <time
              datetime={article.data.date.toISOString()}
              class="text-xs text-zinc-400 dark:text-zinc-600 shrink-0 mt-0.5"
            >
              {article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3">
            {article.data.description}
          </p>
          {article.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {article.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </a>
      </article>
    ))}
  </div>
</Base>
