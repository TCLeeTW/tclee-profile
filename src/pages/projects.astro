---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const statusLabel: Record<string, string> = {
  ongoing: 'ongoing',
  active: 'active',
  completed: 'completed',
};

const statusColor: Record<string, string> = {
  ongoing: 'bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-400',
  active: 'bg-green-50 text-green-700 dark:bg-green-950 dark:text-green-400',
  completed: 'bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400',
};
---

<Base title="Projects" description="Real projects TC Lee has run — civil defense, AI implementation, information resilience.">
  <div class="mb-10">
    <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-3">Projects</h1>
    <p class="text-zinc-600 dark:text-zinc-400">
      Things I've built, led, or am currently running — not just writing topics.
    </p>
  </div>

  <div class="flex flex-col gap-5">
    {projects.map(async (project) => {
      const { Content } = await project.render();
      return (
        <div class="p-6 border border-zinc-100 dark:border-zinc-800 rounded-xl hover:border-zinc-200 dark:hover:border-zinc-700 transition-colors">
          <div class="flex items-start justify-between gap-4 mb-1">
            <h2 class="font-semibold text-zinc-900 dark:text-zinc-100 text-base leading-snug">
              {project.data.title}
            </h2>
            <span class={`shrink-0 text-xs px-2 py-0.5 rounded-full font-medium ${statusColor[project.data.status]}`}>
              {statusLabel[project.data.status]}
            </span>
          </div>
          <p class="text-xs text-zinc-400 dark:text-zinc-600 mb-3">{project.data.period}</p>
          <p class="text-sm text-zinc-700 dark:text-zinc-300 mb-3 leading-relaxed">{project.data.description}</p>
          <div class="prose prose-sm prose-zinc dark:prose-invert max-w-none
                      prose-p:text-zinc-500 dark:prose-p:text-zinc-500 prose-p:my-0 prose-p:leading-relaxed">
            <Content />
          </div>
          <div class="flex items-center gap-2 mt-4 flex-wrap">
            {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
            {project.data.url && (
              <a href={project.data.url} target="_blank" rel="noopener"
                 class="ml-auto text-xs text-blue-600 dark:text-blue-400 hover:underline">
                Visit ↗
              </a>
            )}
          </div>
        </div>
      );
    })}
  </div>
</Base>
