---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const pillars = [
  {
    icon: '◈',
    label: 'IPC hardware BD',
    body: 'Business development for Axiomtek in European transportation and retail markets. Rail, vehicle onboard, kiosk — the compute inside infrastructure.',
  },
  {
    icon: '◉',
    label: 'Civil defense',
    body: 'Co-founder of 港湖民防團, a community civil defense team in Taipei. EMT certified. Researching how people assess and act on civil risk.',
  },
  {
    icon: '◎',
    label: 'Building with AI',
    body: 'Leading AI implementation POC at Axiomtek. Interested in how small teams use LLMs to punch above their weight — in business, in civic work.',
  },
  {
    icon: '◇',
    label: 'Tech background',
    body: 'Self-taught iOS developer, Shopify builder, entrepreneur. I still write about software when it\'s worth writing about.',
  },
];
---

<Base>
  <section class="mb-20">
    <div class="mb-8">
      <h1 class="text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-4">
        TC Lee
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
        I work in European industrial hardware BD, run a civil defense organization in Taiwan,
        and build things with AI. I write about all three.
      </p>
      <div class="flex items-center gap-4 mt-6">
        <a
          href="/about"
          class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline"
        >
          More about me →
        </a>
        <a
          href="https://linkedin.com/in/t-c-lee"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center text-sm text-zinc-500 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </section>

  <section class="mb-20">
    <h2 class="text-xs font-semibold tracking-widest text-zinc-400 dark:text-zinc-600 uppercase mb-6">
      What I work on
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {pillars.map(p => (
        <div class="p-5 border border-zinc-100 dark:border-zinc-800 rounded-xl hover:border-zinc-200 dark:hover:border-zinc-700 transition-colors">
          <div class="text-blue-500 dark:text-blue-400 text-lg mb-2 font-mono">{p.icon}</div>
          <div class="font-medium text-zinc-900 dark:text-zinc-100 mb-1 text-sm">{p.label}</div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  {articles.length > 0 && (
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-semibold tracking-widest text-zinc-400 dark:text-zinc-600 uppercase">
          Recent writing
        </h2>
        <a href="/writing" class="text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          All posts →
        </a>
      </div>
      <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
        {articles.map(article => (
          <article class="py-5 group">
            <a href={`/writing/${article.slug}`} class="block">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h3 class="font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-1">
                    {article.data.title}
                  </h3>
                  <p class="text-sm text-zinc-500 dark:text-zinc-500 line-clamp-2">
                    {article.data.description}
                  </p>
                </div>
                <time
                  datetime={article.data.date.toISOString()}
                  class="text-xs text-zinc-400 dark:text-zinc-600 shrink-0 mt-0.5"
                >
                  {article.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </time>
              </div>
              {article.data.tags.length > 0 && (
                <div class="flex gap-1.5 mt-2.5">
                  {article.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
